# Image Lambda de l'aperçu OCD — À CONSTRUIRE ET TESTER EN LOCAL AVANT DÉPLOIEMENT (non testé ici).
# Build :  docker build -f Dockerfile.preview -t vecu-ocd-preview .
FROM ros:humble

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential cmake python3-pip python3-colcon-common-extensions \
      python3-pybind11 libeigen3-dev libboost-dev \
    && rm -rf /var/lib/apt/lists/*

# 1) OCD : même commande que sur ton WSL
WORKDIR /ocd
RUN git clone --recurse-submodules https://github.com/TUMFTM/Open-Car-Dynamics.git src_repo
WORKDIR /ocd/src_repo
RUN . /opt/ros/humble/setup.sh && \
    colcon build --packages-up-to ocd_vehicle_models_py \
      --cmake-args -DCMAKE_BUILD_TYPE=Release

# 2) Runtime Lambda
RUN pip3 install --no-cache-dir awslambdaric

# 3) Notre code
WORKDIR /var/task
COPY lambda_preview.py vehicle_preview.py vehicle_validation.py ocd_ego.py ocd_vehicle_dynamics.py ./

# Lambda n'exécute pas `source` : on charge ROS + OCD via ces variables
# (si ocd_vehicle_models_py n'est pas trouvé, ajuste PYTHONPATH selon le dossier install/)
ENV PYTHONPATH=/var/task
COPY lambda_entry.sh /lambda_entry.sh
RUN chmod +x /lambda_entry.sh
ENTRYPOINT ["/lambda_entry.sh"]
CMD ["lambda_preview.handler"]
